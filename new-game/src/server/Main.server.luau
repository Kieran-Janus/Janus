--!strict
-- Server entry point. Add a new service = add a line here.
local Services = script.Parent:WaitForChild("Services")

local DataService = require(Services.DataService)
local HubService = require(Services.HubService)
local MapService = require(Services.MapService)
local NoiseService = require(Services.NoiseService)
local SprintService = require(Services.SprintService)
local ShoutService = require(Services.ShoutService)
local PumpkinService = require(Services.PumpkinService)
local KingService = require(Services.KingService)
local GhostService = require(Services.GhostService)
local VoiceService = require(Services.VoiceService)
local LeaderboardService = require(Services.LeaderboardService)
local VotingService = require(Services.VotingService)
local GameService = require(Services.GameService)
local AIService = require(Services.AIService)

HubService.Start() -- first, so the hub spawn exists before characters load
DataService.Start()
MapService.Start()
NoiseService.Start()
SprintService.Start()
ShoutService.Start()
PumpkinService.Start()
KingService.Start()
GhostService.Start()
VoiceService.Start()
LeaderboardService.Start()
VotingService.Start()
AIService.Start()
GameService.Start()
