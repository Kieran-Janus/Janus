--[[
	Regenerates tests/harness/Api.luau: the events, methods, callbacks and extra properties of
	every engine class, read from luau-lsp's Roblox type definitions (globalTypes.d.luau).
	The harness uses it so that any engine member a script touches exists (events become
	inert signals, unimplemented methods become recorded no-op stubs).

	Usage (from new-game/):
	  lune run tests/harness/tools/gen-api -- path/to/globalTypes.d.luau

	globalTypes.d.luau ships with luau-lsp (the VS Code extension downloads it; it is also at
	https://github.com/JohnnyMorganz/luau-lsp/blob/main/scripts/globalTypes.d.luau).
]]

local fs = require("@lune/fs")
local process = require("@lune/process")
local roblox = require("@lune/roblox")

local input = process.args[1]
assert(input, "usage: lune run tests/harness/tools/gen-api -- path/to/globalTypes.d.luau")
local output = process.args[2] or "tests/harness/Api.luau"

local db = roblox.getReflectionDatabase()

-- Is `prop` a script-visible property of `className` (or a superclass) in Lune's database?
local function inDatabase(className: string, prop: string): boolean
	local class = db:GetClass(className)
	while class do
		local info = class.Properties[prop]
		if info then
			return info.Scriptability ~= "None" and info.Scriptability ~= "Custom"
		end
		class = class.Superclass and db:GetClass(class.Superclass)
	end
	return false
end

-- One-letter hint for a default value of a type: what a stub returns / a missing prop reads.
local function hint(typ: string): string
	typ = typ:gsub("^%s+", ""):gsub("%s+$", "")
	if typ:sub(-1) == "?" then
		return ""
	end
	if typ:sub(1, 1) == "(" and not typ:find("%->") then
		-- a tuple: hint for its first element
		local first = typ:match("^%(([^,%)]+)")
		return if first then hint(first) else ""
	end
	if typ:sub(1, 1) == "{" then
		return "t"
	end
	local map = {
		boolean = "b",
		number = "n",
		string = "s",
		RBXScriptConnection = "c",
		RBXScriptSignal = "g",
		Vector3 = "v",
		CFrame = "f",
		Vector2 = "w",
		Color3 = "3",
		UDim2 = "u",
		Content = "s",
	}
	return map[typ] or ""
end

type Class = {
	Name: string,
	Super: string,
	Events: { string },
	Methods: { string },
	Callbacks: { string },
	Props: { string },
	Seen: { [string]: boolean },
}

local classes: { Class } = {}
local current: Class? = nil

local source = fs.readFile(input)
for line in source:gmatch("[^\n]+") do
	local name, super = line:match("^declare extern type ([%w_]+) extends ([%w_]+) with%s*$")
	if not name then
		name = line:match("^declare extern type ([%w_]+) with%s*$")
	end
	-- Only classes Lune can describe (and Object, the root of every class's members): the rest
	-- can't be created in the harness anyway.
	if name and (name == "Object" or db:GetClass(name) ~= nil) then
		current = {
			Name = name,
			Super = super or "",
			Events = {},
			Methods = {},
			Callbacks = {},
			Props = {},
			Seen = {},
		}
		table.insert(classes, current :: Class)
		continue
	end
	if line:match("^end%s*$") then
		current = nil
		continue
	end
	local class = current
	if not class or line:match("^%s*@") then
		continue
	end
	local body = line:gsub("^%s+", "")
	local method, ret = body:match("^function ([%w_]+)%(.*%): (.*)$")
	if method then
		-- Lower-case aliases (findFirstChild, getChildren, ...) are long deprecated; skip them.
		if not class.Seen[method] and not method:match("^%l") then
			class.Seen[method] = true
			local h = hint(ret)
			table.insert(class.Methods, if h ~= "" then method .. ":" .. h else method)
		end
		continue
	end
	local member, typ = body:match("^([%w_]+): (.*)$")
	if member and not class.Seen[member] then
		class.Seen[member] = true
		if typ:match("^RBXScriptSignal") then
			table.insert(class.Events, member)
		elseif typ:match("^%(.*%)%s*%->") then
			table.insert(class.Callbacks, member)
		elseif not inDatabase(class.Name, member) then
			local h = hint(typ)
			table.insert(class.Props, if h ~= "" then member .. ":" .. h else member)
		end
	end
end

table.sort(classes, function(a, b)
	return a.Name < b.Name
end)

local lines = {
	"-- Generated by tests/harness/tools/gen-api.luau from luau-lsp's globalTypes.d.luau.",
	"-- Do not edit by hand; rerun the generator when the engine API changes.",
	"-- Per class: { superclass, events, methods, callbacks, extra properties } (space separated;",
	"-- ':x' is a default-value hint: b bool, n number, s string, t table, c connection,",
	"-- g signal, v Vector3, f CFrame, w Vector2, 3 Color3, u UDim2).",
	"-- stylua: ignore",
	"return {",
}
local count = 0
for _, class in classes do
	if
		#class.Events + #class.Methods + #class.Callbacks + #class.Props == 0
		and class.Super == ""
	then
		continue
	end
	count += 1
	table.insert(
		lines,
		string.format(
			"\t%s = { %q, %q, %q, %q, %q },",
			class.Name,
			class.Super,
			table.concat(class.Events, " "),
			table.concat(class.Methods, " "),
			table.concat(class.Callbacks, " "),
			table.concat(class.Props, " ")
		)
	)
end
table.insert(lines, "}")
fs.writeFile(output, table.concat(lines, "\n") .. "\n")
print(("wrote %s (%d classes)"):format(output, count))
